{
    "id": "ringDebug",
    "type": "View",
    "size": [700, 700],
    "style": {
        "bgColor": "#f0f0f0"
    },
    "js": ["ring-debug.js"],
    "events": {
        "onLoad": "@onRingDebugLoad"
    },
    "layout": {
        "type": "vertical",
        "spacing": 10,
        "padding": [10, 10, 10, 10],
