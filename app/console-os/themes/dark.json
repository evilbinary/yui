{
  "name": "dark",
  "version": "1.0",
  "description": "YUI Game OS · Console Dark",
  "styles": [
    { "selector": "View", "style": { "bgColor": "transparent" } },
    { "selector": "Label", "style": { "color": "#E6EAF5" } },
    { "selector": "Button", "style": { "bgColor": "#1B2440", "color": "#E6EAF5", "borderRadius": 12 } },

    { "selector": "View.surface", "scrollbar": { "visible": false }, "style": { "bgColor": "transparent" } },
    { "selector": "View.toolbar", "style": { "bgColor": "transparent" } },
    { "selector": "View.console-shell", "style": { "bgColor": "#070B15" } },
    { "selector": "View.hero", "style": { "bgColor": "#101728", "borderRadius": 16 } },
    { "selector": "View.card", "style": { "bgColor": "#101728", "borderRadius": 14 } },
    { "selector": "View.panel", "style": { "bgColor": "#0D1424", "borderRadius": 12 } },
    { "selector": "View.stat-card", "style": { "bgColor": "#151D33", "borderRadius": 12 } },
    { "selector": "View.tile", "style": { "bgColor": "#141C30", "borderRadius": 14 } },
    { "selector": "View.list-row", "style": { "bgColor": "#141C30", "borderRadius": 12 } },
    { "selector": "View.screen", "style": { "bgColor": "#04060D", "borderRadius": 12 } },
    { "selector": "View.badge", "style": { "bgColor": "#1B2440", "borderRadius": 8 } },
    { "selector": "View.bar-track", "style": { "bgColor": "#1B2440", "borderRadius": 3 } },
    { "selector": "View.bar-fill", "style": { "borderRadius": 3 } },

    { "selector": "Label.overline", "style": { "color": "#7C88A6", "fontSize": 10, "fontWeight": "bold" } },
    { "selector": "Label.title", "style": { "color": "#FFFFFF", "fontSize": 18, "fontWeight": "bold" } },
    { "selector": "Label.heading", "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": "bold" } },
    { "selector": "Label.subtitle", "style": { "color": "#9AA6C0", "fontSize": 12 } },
    { "selector": "Label.body", "style": { "color": "#C3CCE0", "fontSize": 12 } },
    { "selector": "Label.caption", "style": { "color": "#7C88A6", "fontSize": 11 } },
    { "selector": "Label.hint", "style": { "color": "#6C7793", "fontSize": 11 } },
    { "selector": "Label.clock", "style": { "color": "#FFFFFF", "fontSize": 42, "fontWeight": "bold" } },
    { "selector": "Label.date", "style": { "color": "#9AA6C0", "fontSize": 13 } },
    { "selector": "Label.stat-value", "style": { "color": "#FFFFFF", "fontSize": 17, "fontWeight": "bold" } },
    { "selector": "Label.stat-label", "style": { "color": "#7C88A6", "fontSize": 10 } },
    { "selector": "Label.tile-title", "style": { "color": "#C3CCE0", "fontSize": 11 } },
    { "selector": "Label.status-time", "style": { "color": "#FFFFFF", "fontSize": 14, "fontWeight": "bold" } },
    { "selector": "Label.status-icon", "style": { "color": "#8B96AE", "fontSize": 11 } },
    { "selector": "Button.icon-badge", "style": { "bgColor": "#1B2440", "color": "#FFFFFF", "fontSize": 24, "borderRadius": 12 } },
    { "selector": "Button.icon-badge-sm", "style": { "bgColor": "#1B2440", "color": "#FFFFFF", "fontSize": 18, "borderRadius": 10 } },
    { "selector": "Button.icon-badge-lg", "style": { "bgColor": "#131B2E", "color": "#FFFFFF", "fontSize": 38, "borderRadius": 16 } },
    { "selector": "Button.icon-chip", "style": { "bgColor": "#1F2740", "color": "#C3CCE0", "fontSize": 13, "borderRadius": 6 } },
    { "selector": "Label.accent-a", "style": { "color": "#FF6B6B", "fontSize": 17, "fontWeight": "bold" } },
    { "selector": "Label.accent-b", "style": { "color": "#38BDF8", "fontSize": 17, "fontWeight": "bold" } },
    { "selector": "Label.accent-c", "style": { "color": "#34D399", "fontSize": 17, "fontWeight": "bold" } },
    { "selector": "Label.accent-d", "style": { "color": "#FACC15", "fontSize": 17, "fontWeight": "bold" } },

    { "selector": "Button.status-btn", "style": { "bgColor": "transparent", "color": "#8B96AE", "fontSize": 11, "borderRadius": 8 } },
    { "selector": "Button.tile-icon", "style": { "bgColor": "#1B2440", "color": "#FFFFFF", "fontSize": 26, "borderRadius": 16 } },
    { "selector": "Button.tile-icon-active", "style": { "bgColor": "#38BDF8", "color": "#05121F", "fontSize": 26, "borderRadius": 16 } },
    { "selector": "Button.primary", "style": { "bgColor": "#38BDF8", "color": "#05121F", "fontWeight": "bold", "fontSize": 12, "borderRadius": 10 } },
    { "selector": "Button.secondary", "style": { "bgColor": "#1B2440", "color": "#C3CCE0", "fontSize": 12, "borderRadius": 10 } },
    { "selector": "Button.ghost", "style": { "bgColor": "transparent", "color": "#7C88A6", "fontSize": 11, "borderRadius": 8 } },
    { "selector": "Button.pill", "style": { "bgColor": "#1B2440", "color": "#38BDF8", "fontSize": 11, "borderRadius": 10 } },
    { "selector": "Button.key", "style": { "bgColor": "#1B2440", "color": "#E6EAF5", "fontSize": 13, "borderRadius": 8 } },
    { "selector": "Button.danger", "style": { "bgColor": "#2A1520", "color": "#FF6B6B", "fontSize": 12, "borderRadius": 10 } },
    { "selector": "Button.list-item", "style": { "bgColor": "#141C30", "color": "#E6EAF5", "fontSize": 12, "borderRadius": 10 } },

    { "selector": "#status_bar", "style": { "bgColor": "#0B1120" } },
    { "selector": "#hint_bar", "style": { "bgColor": "#0B1120" } },
    { "selector": "#hero_time", "style": { "color": "#FFFFFF", "fontSize": 42, "fontWeight": "bold" } },
    { "selector": "#hero_date", "style": { "color": "#9AA6C0", "fontSize": 13 } },
    { "selector": "#emu_grid", "style": { "bgColor": "transparent" } },
    { "selector": "#player_screen", "style": { "bgColor": "#04060D", "borderRadius": 12 } },
    { "selector": "#player_fps", "style": { "color": "#34D399", "fontSize": 12, "fontWeight": "bold" } },
    { "selector": "#emu_hero_title", "style": { "color": "#FFFFFF", "fontSize": 18, "fontWeight": "bold" } },
    { "selector": "#battery_pct", "style": { "color": "#FFFFFF", "fontSize": 34, "fontWeight": "bold" } },

    { "selector": "View:focused", "style": { "borderColor": "#38BDF8", "borderWidth": 2 } },
    { "selector": "Button:focused", "style": { "bgColor": "#25406B", "borderColor": "#38BDF8", "borderWidth": 2 } }
  ]
}
