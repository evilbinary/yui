{
  "id": "focusRoot",
  "type": "View",
  "size": [400, 200],
  "autoTest": true,
  "binary": ["playground", "playground-mqjs"],
  "js": ["../lib/ytest.js", "test-focus.js"],
  "layout": {
    "type": "horizontal",
    "spacing": 10,
    "padding": [10, 10, 10, 10],
    "align": "center"
  },
  "events": {
    "onLoad": "@onFocusTestLoad"
  },
  "children": [
    {
      "id": "fa",
      "type": "View",
      "focusable": true,
      "size": [100, 100],
      "position": [10, 50],
      "style": { "bgColor": "#333333" },
      "events": { "onFocus": "@onFocusA", "onBlur": "@onBlurA" }
    },
    {
      "id": "fb",
      "type": "View",
      "focusable": true,
      "size": [100, 100],
      "position": [120, 50],
      "style": { "bgColor": "#444444" },
      "events": { "onClick": "@onClickB" }
    }
  ]
}
