{
    "id": "readerApp",
    "icon": "📖",
    "title": "Reader",
    "type": "View",
    "size": [0, 0],
    "js": ["../lib/theme.js", "./reader.js"],
    "initialize": "initialize",
    "layout": {
        "type": "vertical",
        "spacing": 0
    },
    "children": [
        {
            "id": "toolbar",
            "type": "View",
            "height": 60,
            "layout": {
                "type": "horizontal",
                "spacing": 10,
                "padding": [15, 10, 15, 10],
                "justifyContent": "space-between"
            },
            "children": [
                {
                    "id": "bookSelector",
                    "type": "Select",
                    "size": [200, 30],
                    "items": [
                        { "value": "book1.txt", "text": "第一章：开始" },
                        { "value": "book2.txt", "text": "第二章：发展" },
                        { "value": "book3.txt", "text": "第三章：高潮" }
                    ],
                    "value": "book1.txt",
                    "events":{
                        "onChange": "@loadBookClick"
                    }
                },
                {
                    "id": "titleText",
                    "type": "Label",
                    "text": "阅读器",
                    "size": [100, 20],
                    "style": {
                        "fontSize": 18,
                        "fontWeight": "bold",
                        "textAlign": "center"
                    }
                },
                {
                    "id": "debugButton",
                    "type": "Button",
                    "text": "Debug",
                    "size": [50, 30],
                    "style": {
                        "fontSize": 12,
                        "borderRadius": 4
                    },
                    "events": {
                        "onClick": "@toggleDebug"
                    }
                },
                {
                    "id": "themeToggle",
                    "type": "Button",
                    "text": "主题",
                    "size": [40, 30],
                    "style": {
                        "fontSize": 12,
                        "borderRadius": 4
                    },
                    "events": {
                        "onClick": "@toggleTheme"
                    }
                }
            ]
        },
        {
            "id": "contentArea",
            "type": "View",
            "flex": 1,
            "layout": {
                "type": "vertical",
                "padding": [20, 0, 40, 80]
            },
            "children": [
                {
                    "id": "chapterTitle",
                    "type": "Label",
                    "text": "第一章：开始",
                    "height": 30,
                    "style": {
                        "fontSize": 24,
                        "fontWeight": "bold",
                        "textAlign": "center",
                        "marginBottom": 20
                    }
                },
                {
                    "id": "contentScroll",
                    "type": "Scroll",
                    "flex": 1,
                    "layout": {
                        "type": "vertical",
                        "padding": [0, 0, 0, 0]
                    },
                    "children": [
                        {
                            "id": "contentText",
                            "type": "Text",
                            "text": "正在加载书籍内容...",
                            "multiline": true,
                            "scrollable": 1,
                            "editable": false,
                            "style": {
                                "fontSize": 16,
                                "lineHeight": 1.6,
                                "textAlign": "justify"
                            }
                        }
                    ]
                },
                {
                    "id": "pageIndicator",
                    "type": "Label",
                    "text": "第 1 页，共 1 页",
                    "height": 20,
                    "style": {
                        "fontSize": 14,
                        "textAlign": "center",
                        "marginTop": 20
                    }
                }
            ]
        },
        {
            "id": "bottomBar",
            "type": "View",
            "height": 50,
            "layout": {
                "type": "horizontal",
                "spacing": 20,
                "padding": [15, 5, 15, 5],
                "justifyContent": "space-between"
            },
            "children": [
                {
                    "id": "navigationControls",
                    "type": "View",
                    "size": [200, 30],
                    "layout": {
                        "type": "horizontal",
                        "spacing": 10,
                        "justifyContent": "center",
                        "align": "center"
                    },
                    "children": [
                        {
                            "id": "prevButton",
                            "type": "Button",
                            "text": "上一页",
                            "size": [60, 25],
                            "style": {
                                "fontSize": 13,
                                "borderRadius": 4
                            },
                            "events": {
                                "onClick": "@goToPrevPage"
                            }
                        },
                        {
                            "id": "pageNumber",
                            "type": "Label",
                            "text": "1 / 1",
                            "size": [40, 20],
                            "style": {
                                "fontSize": 13,
                                "textAlign": "center"
                            }
                        },
                        {
                            "id": "nextButton",
                            "type": "Button",
                            "text": "下一页",
                            "size": [60, 25],
                            "style": {
                                "fontSize": 14,
                                "borderRadius": 4
                            },
                            "events": {
                                "onClick": "@goToNextPage"
                            }
                        }
                    ]
                },
                {
                    "id": "fontControls",
                    "type": "View",
                    "size": [150, 30],
                    "layout": {
                        "type": "horizontal",
                        "spacing": 10,
                        "justifyContent": "center",
                        "align": "center"
                    },
                    "children": [
                        {
                            "id": "decreaseFontButton",
                            "type": "Button",
                            "text": "A-",
                            "size": [40, 25],
                            "style": {
                                "fontSize": 14,
                                "fontWeight": "bold",
                                "borderRadius": 12,
                                "textAlign": "center"
                            },
                            "events": {
                                "onClick": "decreaseFont"
                            }
                        },
                        {
                            "id": "fontSizeLabel",
                            "type": "Label",
                            "text": "16px",
                            "size": [40, 20],
                            "style": {
                                "fontSize": 13,
                                "textAlign": "center"
                            }
                        },
                        {
                            "id": "increaseFontButton",
                            "type": "Button",
                            "text": "A+",
                            "size": [40, 25],
                            "style": {
                                "fontSize": 16,
                                "fontWeight": "bold",
                                "borderRadius": 15,
                                "textAlign": "center"
                            },
                            "events": {
                                "onClick": "@increaseFont"
                            }
                        }
                    ]
                },
                {
                    "id": "progressBar",
                    "type": "Progress",
                    "width": 200,
                    "height": 40,
                    "value": 0
                }
            ]
        }
    ]
}
