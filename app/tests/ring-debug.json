    },
    "children": [
        {"id": "r1", "type": "Progress", "size": [150, 150], "shape": "circle", "value": 3},
        {"id": "r2", "type": "Progress", "size": [150, 150], "shape": "circle", "value": 30},
        {"id": "r3", "type": "Progress", "size": [150, 150], "shape": "circle", "value": 75},
        {"id": "r4", "type": "Progress", "size": [150, 150], "shape": "circle", "value": 100}
    ]
}
