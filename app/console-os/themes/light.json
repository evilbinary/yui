{
  "name": "light",
  "version": "1.0",
  "description": "YUI Game OS · Console Light",
  "styles": [
    { "selector": "View", "style": { "bgColor": "transparent" } },
    { "selector": "Label", "style": { "color": "#141A2B" } },
    { "selector": "Button", "style": { "bgColor": "#E3E8F4", "color": "#141A2B", "borderRadius": 12 } },

    { "selector": "View.surface", "scrollbar": { "visible": false }, "style": { "bgColor": "transparent" } },
    { "selector": "View.toolbar", "style": { "bgColor": "transparent" } },
    { "selector": "View.console-shell", "style": { "bgColor": "#EEF2FA" } },
    { "selector": "View.hero", "style": { "bgColor": "#FFFFFF", "borderRadius": 16 } },
    { "selector": "View.card", "style": { "bgColor": "#FFFFFF", "borderRadius": 14 } },
    { "selector": "View.panel", "style": { "bgColor": "#F4F7FD", "borderRadius": 12 } },
    { "selector": "View.stat-card", "style": { "bgColor": "#F4F7FD", "borderRadius": 12 } },
    { "selector": "View.tile", "style": { "bgColor": "#FFFFFF", "borderRadius": 14 } },
    { "selector": "View.tile-active", "style": { "bgColor": "#E4EEFB", "borderRadius": 14 } },
    { "selector": "View.list-row", "style": { "bgColor": "#FFFFFF", "borderRadius": 12 } },
    { "selector": "View.screen", "style": { "bgColor": "#0B0F1A", "borderRadius": 12 } },
    { "selector": "View.badge", "style": { "bgColor": "#E3E8F4", "borderRadius": 8 } },
    { "selector": "View.bar-track", "style": { "bgColor": "#DFE5F2", "borderRadius": 3 } },
    { "selector": "View.bar-fill", "style": { "borderRadius": 3 } },

    { "selector": "Label.overline", "style": { "color": "#6B7793", "fontSize": 12, "fontWeight": "bold" } },
    { "selector": "Label.title", "style": { "color": "#0C1220", "fontSize": 24, "fontWeight": "bold" } },
    { "selector": "Label.heading", "style": { "color": "#0C1220", "fontSize": 17, "fontWeight": "bold" } },
    { "selector": "Label.subtitle", "style": { "color": "#5A6784", "fontSize": 14 } },
    { "selector": "Label.body", "style": { "color": "#3B465F", "fontSize": 14 } },
    { "selector": "Label.caption", "style": { "color": "#6B7793", "fontSize": 13 } },
    { "selector": "Label.hint", "style": { "color": "#7B87A3", "fontSize": 13 } },
    { "selector": "Label.clock", "style": { "color": "#0C1220", "fontSize": 52, "fontWeight": "bold" } },
    { "selector": "Label.date", "style": { "color": "#5A6784", "fontSize": 15 } },
    { "selector": "Label.stat-value", "style": { "color": "#0C1220", "fontSize": 20, "fontWeight": "bold" } },
    { "selector": "Label.stat-label", "style": { "color": "#6B7793", "fontSize": 12 } },
    { "selector": "Label.tile-title", "style": { "color": "#3B465F", "fontSize": 15 } },
    { "selector": "Label.status-time", "style": { "color": "#0C1220", "fontSize": 16, "fontWeight": "bold" } },
    { "selector": "Label.status-icon", "style": { "color": "#5A6784", "fontSize": 12 } },
    { "selector": "Button.icon-badge", "style": { "bgColor": "#E3E8F4", "color": "#141A2B", "fontSize": 28, "borderRadius": 12 } },
    { "selector": "Button.icon-badge-sm", "style": { "bgColor": "#E3E8F4", "color": "#141A2B", "fontSize": 20, "borderRadius": 10 } },
    { "selector": "Button.icon-badge-lg", "style": { "bgColor": "#1B2440", "color": "#FFFFFF", "fontSize": 42, "borderRadius": 16 } },
    { "selector": "Button.icon-chip", "style": { "bgColor": "#DDE4F0", "color": "#3B465F", "fontSize": 14, "borderRadius": 6 } },
    { "selector": "Label.accent-a", "style": { "color": "#E11D48", "fontSize": 20, "fontWeight": "bold" } },
    { "selector": "Label.accent-b", "style": { "color": "#0284C7", "fontSize": 20, "fontWeight": "bold" } },
    { "selector": "Label.accent-c", "style": { "color": "#059669", "fontSize": 20, "fontWeight": "bold" } },
    { "selector": "Label.accent-d", "style": { "color": "#B45309", "fontSize": 20, "fontWeight": "bold" } },

    { "selector": "Button.status-btn", "style": { "bgColor": "transparent", "color": "#5A6784", "fontSize": 12, "borderRadius": 8 } },
    { "selector": "Button.tile-icon", "style": { "bgColor": "#E3E8F4", "color": "#141A2B", "fontSize": 30, "borderRadius": 16 } },
    { "selector": "Button.tile-icon-active", "style": { "bgColor": "#0284C7", "color": "#FFFFFF", "fontSize": 30, "borderRadius": 16 } },
    { "selector": "Button.primary", "style": { "bgColor": "#0284C7", "color": "#FFFFFF", "fontWeight": "bold", "fontSize": 14, "borderRadius": 10 } },
    { "selector": "Button.secondary", "style": { "bgColor": "#E3E8F4", "color": "#3B465F", "fontSize": 14, "borderRadius": 10 } },
    { "selector": "Button.ghost", "style": { "bgColor": "transparent", "color": "#6B7793", "fontSize": 11, "borderRadius": 8 } },
    { "selector": "Button.pill", "style": { "bgColor": "#E3E8F4", "color": "#0284C7", "fontSize": 13, "borderRadius": 10 } },
    { "selector": "Button.key", "style": { "bgColor": "#E3E8F4", "color": "#141A2B", "fontSize": 13, "borderRadius": 8 } },
    { "selector": "Button.danger", "style": { "bgColor": "#FDE7EC", "color": "#E11D48", "fontSize": 14, "borderRadius": 10 } },
    { "selector": "Button.list-item", "style": { "bgColor": "#FFFFFF", "color": "#141A2B", "fontSize": 14, "borderRadius": 10 } },

    { "selector": "#status_bar", "style": { "bgColor": "#DCE3F2" } },
    { "selector": "#hint_bar", "style": { "bgColor": "#DCE3F2" } },
    { "selector": "#hero_time", "style": { "color": "#0C1220", "fontSize": 52, "fontWeight": "bold" } },
    { "selector": "#hero_date", "style": { "color": "#5A6784", "fontSize": 15 } },
    { "selector": "#emu_grid", "style": { "bgColor": "transparent" } },
    { "selector": "#player_screen", "style": { "bgColor": "#0B0F1A", "borderRadius": 12 } },
    { "selector": "#player_fps", "style": { "color": "#059669", "fontSize": 14, "fontWeight": "bold" } },
    { "selector": "#emu_hero_title", "style": { "color": "#0C1220", "fontSize": 24, "fontWeight": "bold" } },
    { "selector": "#battery_pct", "style": { "color": "#0C1220", "fontSize": 38, "fontWeight": "bold" } },

    { "selector": "View:focused", "style": { "borderColor": "#0E7490", "borderWidth": 2 } },
    { "selector": "Button:focused", "style": { "bgColor": "#CFE3F5", "borderColor": "#0284C7", "borderWidth": 2 } }
  ]
}
