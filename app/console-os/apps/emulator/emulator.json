{
    "id": "page_emulator",
    "title": "模拟器",
    "js": ["emulator.js"],
    "type": "View",
    "variant": "surface",
    "flex": 1,
    "layout": { "type": "vertical", "spacing": 8, "padding": [8, 16, 8, 16] },
    "events": { "onLoad": "@onEmulatorLoad", "onShow": "@onEmulatorShow" },
    "children": [
        {
            "id": "emu_header",
            "type": "View",
            "variant": "card",
            "size": [592, 58],
            "layout": {
                "type": "horizontal",
                "spacing": 10,
                "padding": [8, 10, 8, 10],
                "align": "center"
            },
            "children": [
                { "id": "emu_hero_icon", "type": "Label", "text": "🎮", "size": [42, 42] },
                {
                    "id": "emu_hero_info",
                    "type": "View",
                    "flex": 1,
                    "size": [0, 42],
                    "layout": { "type": "vertical", "spacing": 2, "justifyContent": "center" },
                    "children": [
                        { "id": "emu_hero_title", "type": "Label", "variant": "title", "text": "红白机", "size": [340, 20], "textAlign": "left" },
                        { "id": "emu_hero_sub", "type": "Label", "variant": "caption", "text": "Nintendo Famicom / NES", "size": [340, 14], "textAlign": "left" }
                    ]
                },
                { "id": "btn_emu_first", "type": "Button", "variant": "primary", "text": "快速开始", "size": [80, 30], "events": { "onClick": "@onEmulatorLaunchFirst" } },
                { "id": "btn_emu_back", "type": "Button", "variant": "secondary", "text": "返回桌面", "size": [80, 30], "events": { "onClick": "@goConsoleBack" } }
            ]
        },
        {
            "id": "emu_stats",
            "type": "View",
            "size": [592, 58],
            "layout": { "type": "horizontal", "spacing": 8 },
            "children": [
                {
                    "id": "emu_stat_games_card",
                    "type": "View",
                    "variant": "stat-card",
                    "size": [142, 58],
                    "layout": { "type": "vertical", "spacing": 2, "padding": [8, 9, 8, 9] },
                    "children": [
                        { "id": "emu_stat_games", "type": "Label", "variant": "heading", "text": "0", "size": [124, 18], "textAlign": "left" },
                        { "id": "emu_stat_games_label", "type": "Label", "variant": "stat-label", "text": "已收录游戏", "size": [124, 12], "textAlign": "left" },
                        {
                            "id": "emu_stat_games_track", "variant": "bar-track",
                            "type": "View",
                            "size": [124, 6],
                            "style": { "bgColor": "#1B2440", "borderRadius": 3 },
                            "children": [
                                { "id": "emu_stat_games_fill", "variant": "bar-fill", "type": "View", "size": [0, 6], "style": { "bgColor": "#34D399", "borderRadius": 3 } }
                            ]
                        }
                    ]
                },
                {
                    "id": "emu_stat_core_card",
                    "type": "View",
                    "variant": "stat-card",
                    "size": [142, 58],
                    "layout": { "type": "vertical", "spacing": 2, "padding": [8, 9, 8, 9] },
                    "children": [
                        { "id": "emu_stat_core", "type": "Label", "variant": "heading", "text": "—", "size": [124, 18], "textAlign": "left" },
                        { "id": "emu_stat_core_label", "type": "Label", "variant": "stat-label", "text": "模拟核心", "size": [124, 12], "textAlign": "left" },
                        {
                            "id": "emu_stat_core_track", "variant": "bar-track",
                            "type": "View",
                            "size": [124, 6],
                            "style": { "bgColor": "#1B2440", "borderRadius": 3 },
                            "children": [
                                { "id": "emu_stat_core_fill", "variant": "bar-fill", "type": "View", "size": [124, 6], "style": { "bgColor": "#38BDF8", "borderRadius": 3 } }
                            ]
                        }
                    ]
                },
                {
                    "id": "emu_stat_exts_card",
                    "type": "View",
                    "variant": "stat-card",
                    "size": [142, 58],
                    "layout": { "type": "vertical", "spacing": 2, "padding": [8, 9, 8, 9] },
                    "children": [
                        { "id": "emu_stat_exts", "type": "Label", "variant": "body", "text": "—", "size": [124, 18], "textAlign": "left" },
                        { "id": "emu_stat_exts_label", "type": "Label", "variant": "stat-label", "text": "支持格式", "size": [124, 12], "textAlign": "left" },
                        {
                            "id": "emu_stat_exts_track", "variant": "bar-track",
                            "type": "View",
                            "size": [124, 6],
                            "style": { "bgColor": "#1B2440", "borderRadius": 3 },
                            "children": [
                                { "id": "emu_stat_exts_fill", "variant": "bar-fill", "type": "View", "size": [74, 6], "style": { "bgColor": "#FACC15", "borderRadius": 3 } }
                            ]
                        }
                    ]
                },
                {
                    "id": "emu_stat_romdir_card",
                    "type": "View",
                    "variant": "stat-card",
                    "size": [142, 58],
                    "layout": { "type": "vertical", "spacing": 2, "padding": [8, 9, 8, 9] },
                    "children": [
                        { "id": "emu_stat_romdir", "type": "Label", "variant": "body", "text": "roms/", "size": [124, 18], "textAlign": "left" },
                        { "id": "emu_stat_romdir_label", "type": "Label", "variant": "stat-label", "text": "放 ROM 即加载", "size": [124, 12], "textAlign": "left" },
                        {
                            "id": "emu_stat_romdir_track", "variant": "bar-track",
                            "type": "View",
                            "size": [124, 6],
                            "style": { "bgColor": "#1B2440", "borderRadius": 3 },
                            "children": [
                                { "id": "emu_stat_romdir_fill", "variant": "bar-fill", "type": "View", "size": [124, 6], "style": { "bgColor": "#A78BFA", "borderRadius": 3 } }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "emu_list_header",
            "type": "View",
            "size": [592, 18],
            "layout": { "type": "horizontal", "spacing": 8, "align": "center" },
            "children": [
                { "id": "emu_list_title", "type": "Label", "variant": "overline", "text": "游戏列表", "size": [76, 16], "textAlign": "left" },
                { "id": "emu_list_count", "type": "Label", "variant": "caption", "text": "0 个", "size": [132, 16], "textAlign": "left" },
                { "id": "emu_list_bio", "type": "Label", "variant": "caption", "text": "", "flex": 1, "size": [0, 16], "textAlign": "right" }
            ]
        },
        {
            "id": "emu_rom_list",
            "type": "List",
            "flex": 1,
            "scrollable": 1,
            "data": [],
            "events": { "onSelect": "@onEmulatorRomSelect" },
            "itemTemplate": {
                "type": "Button",
                "variant": "list-item",
                "icon": "${icon}",
                "text": "${line}",
                "iconSize": 16,
                "fontSize": 12,
                "textAlign": "left",
                "style": { "bgColor": "#141C30", "color": "#E6EAF5", "borderRadius": 10 },
                "size": [592, 34]
            },
            "layout": { "type": "vertical", "spacing": 4 }
        }
    ]
}
