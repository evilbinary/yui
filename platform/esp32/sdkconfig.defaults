# 提高主任务栈：watch-os JSON 递归解析 + SPIFFS + JS 引擎
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# 使用自定义分区表（partitions.csv，含 font 数据分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 2MB Flash（QEMU 也按 2MB 生成）
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_POISONING_LIGHT=n

# 支持旧批次 ESP32-C3（v0.0/v0.1/v0.2，部分板子 & QEMU 仿真默认 v0.0）；
# IDF 默认要求 >= v0.3，否则 bootloader 直接拒绝启动
CONFIG_ESP32C3_REV_MIN_0=y

